# ============================================================
# Application
# ============================================================
APP_PORT=4000
APP_SECRET=change-this-to-a-random-64-char-secret-string
NODE_ENV=production

# ============================================================
# Admin Account (single user — password controlled here only)
# Change ADMIN_PASSWORD and restart to update login credentials
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ============================================================
# Anthropic / Claude AI
# Primary mode: Claude CLI session (no API key needed).
#   Install: npm install -g @anthropic-ai/claude-code
#   Authenticate: claude login
# Fallback: set ANTHROPIC_API_KEY below if CLI is not authenticated
# ============================================================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================
# Blog 1 — ViitorCloud (slug: vc)
# ============================================================
BLOG_VC_NAME=ViitorCloud Blog
BLOG_VC_DOMAIN=viitorcloud.com
BLOG_VC_WP_URL=https://viitorcloud.com
BLOG_VC_WP_LOGIN_URL=https://viitorcloud.com/wp-login.php
BLOG_VC_WP_USERNAME=wp-username
BLOG_VC_WP_PASSWORD=wp-password
# For REST API method: generate in WP Admin → Users → Profile → Application Passwords
BLOG_VC_WP_APP_PASSWORD=
# Posting method: "browser" (Playwright, works everywhere) or "api" (REST API + App Password)
BLOG_VC_WP_METHOD=browser
# Context folder: brand markdown files (brand-overview, seo-guidelines, style-guide, etc.)
BLOG_VC_CONTEXT_PATH=../blogs/vc/context
# Generation rules file (word count, FAQ count, voice, formatting for this blog)
BLOG_VC_RULES_PATH=../rules/vc_blog_generation.md
# Category ID and author ID — managed in Settings UI; uncomment to force from .env
# BLOG_VC_WP_CATEGORY=1
# BLOG_VC_WP_AUTHOR_ID=1

# ============================================================
# Blog 2 — EveryCRED (slug: everycred)
# ============================================================
BLOG_EVERYCRED_NAME=EveryCRED Blog
BLOG_EVERYCRED_DOMAIN=everycred.com
BLOG_EVERYCRED_WP_URL=https://everycred.com
BLOG_EVERYCRED_WP_LOGIN_URL=https://everycred.com/wp-login.php
BLOG_EVERYCRED_WP_USERNAME=wp-username
BLOG_EVERYCRED_WP_PASSWORD=wp-password
BLOG_EVERYCRED_WP_APP_PASSWORD=
BLOG_EVERYCRED_WP_METHOD=browser
BLOG_EVERYCRED_CONTEXT_PATH=../blogs/everycred/context
BLOG_EVERYCRED_RULES_PATH=../rules/everycred_blog_generation.md
# BLOG_EVERYCRED_WP_CATEGORY=1
# BLOG_EVERYCRED_WP_AUTHOR_ID=1

# ============================================================
# Blog 3 — EveryTicket (slug: everyticket)
# ============================================================
BLOG_EVERYTICKET_NAME=EveryTicket Blog
BLOG_EVERYTICKET_DOMAIN=everyticket.in
BLOG_EVERYTICKET_WP_URL=https://everyticket.in
BLOG_EVERYTICKET_WP_LOGIN_URL=https://everyticket.in/wp-login.php
BLOG_EVERYTICKET_WP_USERNAME=wp-username
BLOG_EVERYTICKET_WP_PASSWORD=wp-password
BLOG_EVERYTICKET_WP_APP_PASSWORD=
BLOG_EVERYTICKET_WP_METHOD=browser
BLOG_EVERYTICKET_CONTEXT_PATH=../blogs/everyticket/context
BLOG_EVERYTICKET_RULES_PATH=../rules/everyticket_blog_generation.md
# BLOG_EVERYTICKET_WP_CATEGORY=1
# BLOG_EVERYTICKET_WP_AUTHOR_ID=1

# ============================================================
# Add more blogs below — copy the block above, change the slug
# Steps to add a new blog:
#   1. Add BLOG_{SLUG}_* vars here
#   2. Create blogs/{slug}/context/ with brand markdown files
#   3. Create rules/{slug}_blog_generation.md
#   4. Restart the server — blog is auto-seeded from .env
# ============================================================
# BLOG_NEWBLOG_NAME=New Blog
# BLOG_NEWBLOG_DOMAIN=newblog.com
# BLOG_NEWBLOG_WP_URL=https://newblog.com
# BLOG_NEWBLOG_WP_LOGIN_URL=https://newblog.com/wp-login.php
# BLOG_NEWBLOG_WP_USERNAME=wp-username
# BLOG_NEWBLOG_WP_PASSWORD=wp-password
# BLOG_NEWBLOG_WP_APP_PASSWORD=
# BLOG_NEWBLOG_WP_METHOD=browser
# BLOG_NEWBLOG_CONTEXT_PATH=../blogs/newblog/context
# BLOG_NEWBLOG_RULES_PATH=../rules/newblog_blog_generation.md
# BLOG_NEWBLOG_WP_CATEGORY=1
# BLOG_NEWBLOG_WP_AUTHOR_ID=1

# ============================================================
# Queue Settings
# ============================================================
QUEUE_CONCURRENCY=1
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=30000
# Minutes to wait before auto-resuming when Claude usage limit is hit
# (used as fallback if the reset time is not available from the API)
LIMIT_RESUME_FALLBACK_MIN=30

# ============================================================
# Featured Image (optional — falls back to SVG gradient if unset)
# Pexels: https://www.pexels.com/api/  (200 req/hour free)
# Unsplash: https://unsplash.com/developers  (50 req/hour free)
# ============================================================
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ============================================================
# Batch Webhook (optional)
# Called when an upload batch finishes. Slack/Discord/Teams compatible.
# ============================================================
BATCH_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# SEO Machine engine (optional — added for the app/ overlay)
# The engine is normally chosen in the UI (Claude Setup → Generation Engine) and
# persisted in the DB (queue_state.generation_engine). These are fallbacks/overrides only.
# No new secrets needed — the seomachine engine reuses the same Claude session + WP creds.
# ─────────────────────────────────────────────────────────────
# Default engine when the DB has none set: native | seomachine
GENERATION_ENGINE=native
# seomachine repo root (defaults to the parent of app/; set only if non-standard)
# SEOMACHINE_ROOT=/var/www/html/blogs-CT/seomachine
# Python used for the quality gate (scrub + score). Default: python3
# SEOMACHINE_PYTHON=python3
# Where generated repurpose .md files + manifests are written. Relative paths resolve
# against the seomachine repo root; absolute paths are used as-is. Default: ./repurposed
# REPURPOSE_OUTPUT_PATH=./repurposed
# Sites API that powers the Repurpose "Sites" dropdown — GET returns
# { data: { list: [{ id, name, url }, ...] } }. Default: http://localhost:8000/sites
# REPURPOSE_SITES_API_URL=http://localhost:8000/sites
# Categories API — GET returns { data: { list: [{ slug, name, color, order, account_count,
# sites: [{siteId, name, url, account_count, accounts}] }, ...] } } — powers the Repurpose
# "Category" filter AND each site's auto-calculated Count (per-category account_count,
# joined on siteId). Default: http://localhost:8000/categories
# REPURPOSE_CATEGORIES_API_URL=http://localhost:8000/categories

# MongoDB — every generated repurpose variation is recorded here (md_path/image_path,
# not inline content) in the "repurposed_posts" collection, alongside Blogbot's own DB,
# for another tool to pick up. Best-effort: a Mongo write failure never blocks the
# actual .md/image files from being generated.
# REPURPOSE_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=your-app
# Same database Blogbot itself uses (its own BLOGBOT_DB), unless you created
# repurposed_posts in a different database.
# REPURPOSE_MONGODB_DB=blogbot
